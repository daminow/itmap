{
  "name": "itmap",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive map of IT specialties: 170 roles across 22 domains as a CEO -> C-suite -> department -> role org chart, with filters (salary/experience/stack/level/type), multi-currency, and three synchronized views.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Timur Daminov",
  "homepage": "https://itmap.daminov.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daminow/itmap.git"
  },
  "bugs": {
    "url": "https://github.com/daminow/itmap/issues"
  },
  "keywords": [
    "it-careers",
    "salary-map",
    "taxonomy",
    "react",
    "d3",
    "sunburst",
    "data-visualization",
    "hiring"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "vitest run src/data/dataset.test.ts"
  },
  "dependencies": {
    "@fontsource/lora": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@radix-ui/react-slider": "^1.4.1",
    "d3-hierarchy": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "immer": "^10.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.19.0",
    "vite": "^7.3.1",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  }
}
